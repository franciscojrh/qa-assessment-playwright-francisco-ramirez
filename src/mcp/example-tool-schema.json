{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SampleCustomToolSchema",
  "description": "Template schema illustrating custom MCP tool definition for test data calculation or DOM inspection.",
  "type": "object",
  "properties": {
    "targetField": {
      "type": "string",
      "description": "Identifier for the target UI component or data field"
    },
    "expectedValue": {
      "type": "number",
      "minimum": 0,
      "description": "Expected numeric calculation result"
    },
    "options": {
      "type": "object",
      "properties": {
        "strictMode": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["targetField", "expectedValue"],
  "additionalProperties": false
}
