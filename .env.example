# Copy to .env.dev (gitignored). Default smoke target is playwright.dev until you
# point BASE_URL at your app.
BASE_URL=https://playwright.dev

# Optional — API specs under tests/api/
# API_BASE_URL=https://api.example.com
# API_KEY=

# Optional Cognito Hosted UI — see docs/recipes/cognito-hosted-ui.md
# E2E_USER=
# E2E_PASSWORD=
# E2E_AUTH=local
